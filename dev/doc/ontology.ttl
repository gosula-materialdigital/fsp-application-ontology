                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ]
                                                      ] ;
                                      rdfs:label "functional material"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "A functional material F is a material which has the function to be used for an object O (O consists of F) and O's function is other/more than mechanical load carrying."@en .


###  https://w3id.org/pmd/co/PMD_0000661
<https://w3id.org/pmd/co/PMD_0000661> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000000> ;
                                      rdfs:label "glass"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "material present as an amorphous solid typically formed by rapid cooling of a melt"@en .


###  https://w3id.org/pmd/co/PMD_0000777
<https://w3id.org/pmd/co/PMD_0000777> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ,
                                                      <https://w3id.org/pmd/co/PMD_0020313> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000054> ;
                                                        owl:someValuesFrom <https://w3id.org/pmd/co/PMD_0000520>
                                                      ] ;
                                      rdfs:label "Wärmekapazität"@de ,
                                                 "heat capacity"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Die Wärmekapazität ist eine thermische Eigenschaft, die die Menge an Wärmeenergie beschreibt, die erforderlich ist, um die Temperatur einer Entität um einen bestimmten Betrag zu erhöhen."@de ,
                                                                                       "The heat capacity is a thermal property describing the amount of heat energy required to raise the temperature of an entity by a given amount."@en .


###  https://w3id.org/pmd/co/PMD_0000790
<https://w3id.org/pmd/co/PMD_0000790> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000877> ;
                                      rdfs:label "Brechung"@de ,
                                                 "optical refraction"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Optical property which describes the bending of light as it passes from one medium into another due to a change in the light’s speed."@en ,
                                                                                       "Optische Eigenschaft, die die Ablenkung des Lichts beim Übergang von einem Medium in ein anderes aufgrund einer Änderung der Lichtgeschwindigkeit beschreibt."@de .


###  https://w3id.org/pmd/co/PMD_0000833
<https://w3id.org/pmd/co/PMD_0000833> rdf:type owl:Class ;
                                      owl:equivalentClass [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/COB_0000035>
