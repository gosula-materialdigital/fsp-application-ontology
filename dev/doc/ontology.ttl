                                             rdfs:range <http://purl.obolibrary.org/obo/IAO_0000030> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "inverse of the relation 'denotes'"@en ;
                                             rdfs:label "denoted by"@en .


###  http://purl.obolibrary.org/obo/OBI_0000293
