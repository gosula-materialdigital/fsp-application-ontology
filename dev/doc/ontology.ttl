                                             owl:inverseOf <http://purl.obolibrary.org/obo/OBI_0000312> ;
                                             rdfs:domain <http://purl.obolibrary.org/obo/COB_0000035> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "The inverse property of is specified output of" ;
