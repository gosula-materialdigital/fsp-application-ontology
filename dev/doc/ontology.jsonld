    "@value" : "1"
  } ],
  "http://www.w3.org/2002/07/owl#onProperty" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OBI_0001937"
  } ]
}, {
  "@id" : "_:genid93",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
