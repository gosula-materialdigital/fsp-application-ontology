        <rdfs:label xml:lang="en">dispersion gas</rdfs:label>
        <skos:definition>Gas which is used to disperse a liquid into droplets.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000008 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">nanoparticle synthesis</rdfs:label>
        <skos:definition>A manufacturing process with the intend to synthesize nanoparticles.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000009 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000009">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/fsp/FSP_0000008"/>
