            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">flow rate</rdfs:label>
        <skos:definition xml:lang="en">process attribute that represents the amount of transported entites per time</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020227 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020227">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020259"/>
