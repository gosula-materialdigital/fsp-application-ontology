                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_60003"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020228"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">solution</rdfs:label>
        <skos:definition xml:lang="en">A portion of matter that is homogeneous, made up of at least two entity types, one playing the role of sovlent and the others playing the role of solute</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020230 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020230">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020229"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020293"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020229"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020293"/>
        <rdfs:label xml:lang="en">solid solution</rdfs:label>
        <skos:definition xml:lang="en">a solution with solid aggregate state</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020245 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">transport</rdfs:label>
        <skos:definition xml:lang="en">is a process in which an entity being moved within or accross another entity</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020246 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020246">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020245"/>
        <rdfs:label xml:lang="en">continous transport</rdfs:label>
        <skos:definition xml:lang="en">recurring transport of multiple entities, such that the transported entities are not being discretized anymore</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020258 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
        <rdfs:label xml:lang="en">failure</rdfs:label>
        <skos:definition xml:lang="en">a process boundary at which a function of a participant ceases to exist</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020259 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020259">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020265"/>
        <rdfs:label xml:lang="en">chemical property</rdfs:label>
        <skos:definition xml:lang="en">a property that is commonly associated with the domain of chemistry</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020265 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <rdfs:label xml:lang="en">property</rdfs:label>
        <skos:definition xml:lang="en">property is a collection class for entities that are either qualites (represent a state) or realizable entities (represent a behavior)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020287 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020287">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020288"/>
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020289"/>
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020290"/>
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020291"/>
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020292"/>
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020293"/>
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020294"/>
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020295"/>
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020296"/>
        </owl:disjointUnionOf>
        <rdfs:label xml:lang="en">portion of matter in aggregate state</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter that is at the same time in a specific aggregate state</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020288 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020288">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:label xml:lang="en">atom gas</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in an gaseous aggregate state where the gas entities are atoms</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020289 -->


