                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000029"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000140"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">spatial extend</rdfs:label>
        <skos:definition xml:lang="en">Dimension quality is a quality of a material entity that pertains to its measurable spatial extent, such as length, area, or volume</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020133 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020133">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="de">Masse</rdfs:label>
        <rdfs:label xml:lang="en">mass</rdfs:label>
        <skos:definition xml:lang="en">Mass is fundamental extensive quality.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020136 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">phase transformation</rdfs:label>
        <skos:definition xml:lang="en">A thermodynamic phase transformation is a process in/of a thermodynamic system, that involves the transformation of phases of the system to other phases.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020142 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="de">Energie</rdfs:label>
        <rdfs:label xml:lang="en">energy</rdfs:label>
        <skos:definition xml:lang="en">an extensive quality of material entities which manifests as a capacity to perform work (such as causing motion or the interaction of molecules)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020150 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020150">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023000"/>
        <rdfs:label xml:lang="de">Volumen</rdfs:label>
        <rdfs:label xml:lang="en">volume</rdfs:label>
        <skos:definition xml:lang="en">Volume is a three dimensional size.</skos:definition>
        <skos:definition xml:lang="de">Volumen ist eine dreidimensionale Größe.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020151 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020151">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020142"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023000"/>
        <rdfs:label xml:lang="de">innere Energie</rdfs:label>
        <rdfs:label xml:lang="en">internal energy</rdfs:label>
        <skos:definition xml:lang="de">Innere Energie ist eine universelle umfassende Qualität, die das Potenzial des Trägers zur Arbeit festlegt.</skos:definition>
        <skos:definition xml:lang="en">Internal energy is a universal extensive quality that specifies the bearers potential to do work.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020152 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:label xml:lang="en">component</rdfs:label>
        <skos:definition xml:lang="en">A component is an object aggregate that bears a function in a technical system.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020161 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_60003"/>
