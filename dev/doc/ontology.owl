                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020229"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">activity (thermodynamic)</rdfs:label>
        <rdfs:label xml:lang="de">thermodynamische Aktivität</rdfs:label>
        <skos:definition xml:lang="en">Thermodynamic activity is a relational quality that inheres between a chemical species and a non-ideal solution and represents the effective concentration of the species accounting for particle interactions.</skos:definition>
        <skos:definition xml:lang="de">Thermodynamische Aktivität ist eine Beziehungsqualität, die zwischen einer chemischen Spezies und einer nicht idealen Lösung innewohnt und die effektive Konzentration der Spezies darstellt, die für Partikelwechselwirkungen verantwortlich ist.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020200 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020200">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">force</rdfs:label>
        <skos:definition xml:lang="en">A force is an entity that consists of a reciprocal interaction between two objects and is realized as equal and opposite influences capable of changing motion or causing deformation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020216 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020216">
        <rdfs:label xml:lang="en">DEPRECATED order scale value</rdfs:label>
        <skos:definition xml:lang="de">DEPRECATED Mögliche Werte der charakteristischen Länge, über die strukturelle Zusammenhänge in einem Material bestehen bleiben</skos:definition>
        <skos:definition xml:lang="en">DEPRECATED possible values of characteristic length over which structural correlations persist in a material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020226 -->


    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020226">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025019"/>
