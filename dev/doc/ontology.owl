        <rdfs:label xml:lang="en">recipe</rdfs:label>
        <skos:definition xml:lang="en">A plan specification that outlines the ingredients, proportions, and procedural steps required to prepare a specific product, typically in cooking, manufacturing, or chemical processes.</skos:definition>
    </owl:Class>
    


