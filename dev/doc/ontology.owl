        <rdfs:label xml:lang="de">Flammensprühpyrolyse</rdfs:label>
        <rdfs:label xml:lang="en">flame spray pyrolysis</rdfs:label>
        <skos:definition>A manufacturing process with the intend to synthesize aggregated nanoparticles in the gas phase through the controlled combustion of a dispersed liquid precursor solution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000010 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000002"/>
        <rdfs:label xml:lang="en">nanoparticle</rdfs:label>
        <skos:definition>A nanoscale particle</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000011 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">nozzle nozzle distance</rdfs:label>
        <skos:definition>Euclidean distance between  the annular gaps of two nozzles.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000012 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">nozzle filter distance</rdfs:label>
        <skos:definition>Distance bewtween the annular gap of a nozzle and a filter medium.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000013 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020152"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">deposition component</rdfs:label>
        <skos:definition>The component used to separate an entity from a gas flow, e.g. a filter.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000014 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/fsp/FSP_0000013"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">nanoparticle filter</rdfs:label>
        <skos:definition>A component used for retrieving nanoparticles from the gas flow. Nanoparticles will accumulate on the filter and can later be scraped off.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000015 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000015">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/fsp/FSP_0000014"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">GD/F filter</rdfs:label>
        <skos:definition>Filter class, made of amorphous silicon dioxide.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000016 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000016">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020152"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">enclosure</rdfs:label>
        <skos:definition>Physical hollow body which surrounds an entitiy with the purpose to protect it from ambient influences.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000017 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000017">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020152"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">nozzle</rdfs:label>
        <skos:definition>A short tube with a taper or constriction used (as on a hose) to speed up or direct a flow of fluid.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000018 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000018">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/fsp/FSP_0000017"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">spray syn nozzle</rdfs:label>
        <skos:definition>A standard for a free-jet type burner that offers well-defined and simulation-friendly boundary conditions and geometries as well as accessibility for optical diagnostics.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000019 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000019">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/fsp/FSP_0000017"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">tethis nozzle</rdfs:label>
        <skos:definition>An external-mixing gas-assisted nozzle that is made from a capillary tube of outer diameter 0.91 mm (inner diameter 0.6 mm) that lies in an opening of 1.2 mm in diameter creating an annular gap of 0.48 mm^2 maximum area. Precursor and fuel flow through the capillary tube while the dispersion gas passes through the annular gap. The capillary ends 0.5 mm above the opening.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000020 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020152"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">vacuum pump</rdfs:label>
        <skos:definition>A piece of equipment for removing air or gas from a container, creating a vacuum inside.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000021 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020101"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">molarity</rdfs:label>
        <skos:definition>Molarity is a unit of concentration expressed as the number of moles of dissolved solute per liter of solution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000022 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="de">Reinheit</rdfs:label>
        <rdfs:label xml:lang="en">purity</rdfs:label>
        <skos:definition>The quality or state of being pure</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000023 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020113"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">precursor</rdfs:label>
        <skos:definition>Liquid solution composed of solvent and solute that is dispersed and combusted in a flame spray pyrolysis process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000024 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000024">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020113"/>
        <rdfs:label xml:lang="en">solvent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000025 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">solute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/fsp/FSP_0000026 -->


    <owl:Class rdf:about="https://w3id.org/pmd/fsp/FSP_0000026">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020226"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/pmd/fsp/"/>
        <rdfs:label xml:lang="en">feed rate</rdfs:label>
