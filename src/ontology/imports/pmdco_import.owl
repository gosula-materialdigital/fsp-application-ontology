AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000877> "optische Eigenschaft"@de)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0000877> "a property that is commonly associated with the domain of optics"@en)
