###  https://w3id.org/pmd/fsp/FSP_0000000
<https://w3id.org/pmd/fsp/FSP_0000000> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/fsp/FSP_0000027> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/pmd/co/PMD_0025006> ;
                                                         owl:someValuesFrom <https://w3id.org/pmd/fsp/FSP_0000037>
                                                       ] ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "dispersion gas flow rate"@en ;
                                       skos:definition "A gas flow that is the volumetric flow rate of the dispersion gas in a dispersion gas flow process."@en .


###  https://w3id.org/pmd/fsp/FSP_0000001
<https://w3id.org/pmd/fsp/FSP_0000001> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000008> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "pressure drop"@en ;
                                       skos:definition "A process attribute of a fluid flow process that is the difference between the static pressure of the fluid upstream and downstream of a flow-restricting component, e.g. the nozzle gap or the filter."@en .


###  https://w3id.org/pmd/fsp/FSP_0000002
<https://w3id.org/pmd/fsp/FSP_0000002> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000602> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "reactor"@en ;
                                       skos:definition "A device that encloses a space in which a chemical reaction is carried out under controlled conditions."@en .


###  https://w3id.org/pmd/fsp/FSP_0000003
<https://w3id.org/pmd/fsp/FSP_0000003> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/fsp/FSP_0000002> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "flame spray pyrolysis reactor"@en ;
                                       skos:definition "A reactor in which flame spray pyrolysis is carried out; it comprises at least one nozzle, a nanoparticle filter and a vacuum pump, and optionally an enclosure."@en .


###  https://w3id.org/pmd/fsp/FSP_0000004
<https://w3id.org/pmd/fsp/FSP_0000004> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020289> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "sheath gas"@en ;
                                       skos:definition "A gas that is supplied around the flame of a flame spray pyrolysis reactor to shield it from ambient influences (e.g. entrainment of ambient air) and to stabilise it."@en .


###  https://w3id.org/pmd/fsp/FSP_0000005
<https://w3id.org/pmd/fsp/FSP_0000005> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020289> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "oxidation gas"@en ;
                                       skos:definition "A gas (typically oxygen) that is premixed with the fuel gas and supplies the oxidant for its combustion in the pilot flame."@en .


###  https://w3id.org/pmd/fsp/FSP_0000006
<https://w3id.org/pmd/fsp/FSP_0000006> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020289> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "fuel gas"@en ;
                                       skos:definition "A combustible gas (typically methane) that is burned together with the oxidation gas in the pilot flame to ignite and stabilise the spray flame."@en .


###  https://w3id.org/pmd/fsp/FSP_0000007
<https://w3id.org/pmd/fsp/FSP_0000007> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020289> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "dispersion gas"@en ;
                                       skos:definition "A gas (typically oxygen) that flows through the annular gap of the nozzle and atomises the precursor solution into a spray; it also supplies oxygen for the spray combustion."@en .


###  https://w3id.org/pmd/fsp/FSP_0000008
<https://w3id.org/pmd/fsp/FSP_0000008> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000833> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "nanoparticle synthesis"@en ;
                                       skos:definition "A manufacturing process that has nanoparticles as its specified output."@en .


###  https://w3id.org/pmd/fsp/FSP_0000009
<https://w3id.org/pmd/fsp/FSP_0000009> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/fsp/FSP_0000008> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "Flammensprühpyrolyse"@de ,
                                                  "flame spray pyrolysis"@en ;
                                       skos:definition "A nanoparticle synthesis in which a precursor solution is atomised by a dispersion gas into a spray and combusted in a flame, so that nanoparticles form in the gas phase."@en .


###  https://w3id.org/pmd/fsp/FSP_0000010
<https://w3id.org/pmd/fsp/FSP_0000010> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000002> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "nanoparticle"@en ;
                                       skos:definition "An engineered material that is a particle with all three external dimensions in the nanoscale (approx. 1-100 nm, cf. ISO/TS 80004-1)."@en .


###  https://w3id.org/pmd/fsp/FSP_0000011
<https://w3id.org/pmd/fsp/FSP_0000011> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000141> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "nozzle nozzle distance"@en ;
                                       skos:definition "A distance between the outlets (annular gaps) of two nozzles in a multi-flame flame spray pyrolysis reactor."@en .


###  https://w3id.org/pmd/fsp/FSP_0000012
<https://w3id.org/pmd/fsp/FSP_0000012> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000141> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "nozzle filter distance"@en ;
                                       skos:definition "A distance between the outlet (annular gap) of a nozzle and the filter medium."@en .


###  https://w3id.org/pmd/fsp/FSP_0000013
<https://w3id.org/pmd/fsp/FSP_0000013> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020152> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "deposition component"@en ;
                                       skos:definition "A component that separates particles from a gas flow and collects them, e.g. a filter."@en .


###  https://w3id.org/pmd/fsp/FSP_0000014
<https://w3id.org/pmd/fsp/FSP_0000014> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/fsp/FSP_0000013> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "nanoparticle filter"@en ;
                                       skos:definition "A deposition component on which nanoparticles from the off-gas accumulate and from which they can later be scraped off."@en .


###  https://w3id.org/pmd/fsp/FSP_0000015
<https://w3id.org/pmd/fsp/FSP_0000015> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/fsp/FSP_0000014> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "GD/F filter"@en ;
                                       skos:definition "A nanoparticle filter made of glass microfibre (amorphous silicon dioxide)."@en .


###  https://w3id.org/pmd/fsp/FSP_0000016
<https://w3id.org/pmd/fsp/FSP_0000016> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020152> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "enclosure"@en ;
                                       skos:definition "A component that is a hollow body surrounding the flame of a flame spray pyrolysis reactor to protect the process from ambient influences (closed reactor)."@en .


###  https://w3id.org/pmd/fsp/FSP_0000017
<https://w3id.org/pmd/fsp/FSP_0000017> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020152> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "nozzle"@en ;
                                       skos:definition "A component of a flame spray pyrolysis reactor that comprises a capillary for the precursor solution, an annular gap for the dispersion gas and a pilot flame ring, and forms the spray and the flame."@en .


###  https://w3id.org/pmd/fsp/FSP_0000018
<https://w3id.org/pmd/fsp/FSP_0000018> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/fsp/FSP_0000017> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "spray syn nozzle"@en ;
                                       skos:definition "A nozzle built to the SpraySyn standard burner design, a free-jet spray flame burner with well-defined, simulation-friendly boundary conditions and geometry and optical access for diagnostics."@en .


###  https://w3id.org/pmd/fsp/FSP_0000019
<https://w3id.org/pmd/fsp/FSP_0000019> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/fsp/FSP_0000017> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "tethis nozzle"@en ;
                                       skos:definition "An external-mixing gas-assisted nozzle that is made from a capillary tube of outer diameter 0.91 mm (inner diameter 0.6 mm) that lies in an opening of 1.2 mm in diameter creating an annular gap of 0.48 mm^2 maximum area. Precursor and fuel flow through the capillary tube while the dispersion gas passes through the annular gap. The capillary ends 0.5 mm above the opening." .


###  https://w3id.org/pmd/fsp/FSP_0000020
<https://w3id.org/pmd/fsp/FSP_0000020> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020152> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "vacuum pump"@en ;
                                       skos:definition "A device that removes gas from an enclosed volume; in a flame spray pyrolysis reactor it draws the off-gas with the particles through the nanoparticle filter."@en .


###  https://w3id.org/pmd/fsp/FSP_0000021
<https://w3id.org/pmd/fsp/FSP_0000021> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020272> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "molarity"@en ;
                                       skos:definition "A count per volume of a solution that is the amount of substance (moles) of a solute per volume of the solution, usually expressed in mol/L."@en .


###  https://w3id.org/pmd/fsp/FSP_0000022
<https://w3id.org/pmd/fsp/FSP_0000022> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020103> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "Reinheit"@de ,
                                                  "purity"@en ;
                                       skos:definition "A molar fraction of a gas that is the proportion of its main substance in it; usually given as a purity grade, e.g. grade 5.0 = at least 99.999 %."@en .


###  https://w3id.org/pmd/fsp/FSP_0000023
<https://w3id.org/pmd/fsp/FSP_0000023> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020229> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "precursor"@en ;
                                       skos:definition "A solution of one or more metal-containing solutes in a solvent that is fed to a flame spray pyrolysis process and combusted to form nanoparticles."@en .


###  https://w3id.org/pmd/fsp/FSP_0000024
<https://w3id.org/pmd/fsp/FSP_0000024> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020290> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "solvent"@en ;
                                       skos:definition "A liquid that bears a solvent role in a precursor solution; it dissolves the solutes and is the main fuel of the spray flame (e.g. xylene, ethanol, 2-ethylhexanoic acid)."@en .


###  https://w3id.org/pmd/fsp/FSP_0000025
<https://w3id.org/pmd/fsp/FSP_0000025> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0000001> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "solute"@en ;
                                       skos:definition "A portion of matter that bears a solute role in a precursor solution and supplies the metal of the product nanoparticles (e.g. a metal-organic compound or metal salt)."@en .


###  https://w3id.org/pmd/fsp/FSP_0000026
<https://w3id.org/pmd/fsp/FSP_0000026> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020226> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "feed rate"@en ;
                                       skos:definition "A flow rate that is the volume of a liquid fed into a process per unit time."@en .


###  https://w3id.org/pmd/fsp/FSP_0000027
<https://w3id.org/pmd/fsp/FSP_0000027> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/pmd/co/PMD_0020226> ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "gas flow"@en ;
                                       skos:definition "A flow rate that is the volume of a gas supplied per unit time."@en .


###  https://w3id.org/pmd/fsp/FSP_0000028
<https://w3id.org/pmd/fsp/FSP_0000028> rdf:type owl:Class ;
                                       rdfs:subClassOf obo:COB_0000035 ,
                                                       <https://w3id.org/pmd/co/PMD_0020246> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:OBI_0000293 ;
                                                         owl:someValuesFrom <https://w3id.org/pmd/fsp/FSP_0000023>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/pmd/co/PMD_0000009> ;
                                                         owl:someValuesFrom <https://w3id.org/pmd/fsp/FSP_0000042>
                                                       ] ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "precursor feeding process"@en ;
                                       skos:definition "A continuous transport in which the precursor solution is fed at a controlled feed rate through the capillary of the nozzle."@en .


###  https://w3id.org/pmd/fsp/FSP_0000029
