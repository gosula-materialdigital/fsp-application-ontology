                                                       ] ;
                                       rdfs:isDefinedBy <https://w3id.org/pmd/fsp/> ;
                                       rdfs:label "spray combustion"@en ;
                                       skos:definition "A chemical reaction in which the atomised precursor solution burns with oxygen in the spray flame, so that the precursor decomposes and nanoparticles form in the gas phase as an aerosol."@en .


