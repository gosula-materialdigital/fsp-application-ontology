Prefix(:=<https://w3id.org/pmd/fsp/>)
Prefix(dce:=<http://purl.org/dc/elements/1.1/>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)


Ontology(<https://w3id.org/pmd/fsp/>
Import(<https://w3id.org/pmd/fsp/components/fsp-axioms-shared.owl>)
Import(<https://w3id.org/pmd/fsp/components/fsp-shared.owl>)
Import(<https://w3id.org/pmd/fsp/components/imports-edit.owl>)
Import(<https://w3id.org/pmd/fsp/imports/pmdco_import.owl>)
Annotation(dcterms:creator "Divya Gosula")
Annotation(dcterms:description "Application ontology for the flame spray pyrolysis (FSP) process for manufacturing nanoparticles, aligned with the PMD Core Ontology (PMDco).")
Annotation(dcterms:license <https://creativecommons.org/licenses/by/4.0/>)
Annotation(dcterms:title "Flame Spray Pyrolysis Ontology")

Declaration(Class(<https://w3id.org/pmd/co/PMD_0020101>))
Declaration(Class(<https://w3id.org/pmd/co/PMD_0020113>))
